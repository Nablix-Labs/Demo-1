NABLIX_APP_NAME=Nablix AI Math Tutor API
NABLIX_VOICE_SERVICE_URL=http://localhost:8004
# Nablix FastAPI backend runs on 8001; Saravanan's Student Model runs on 8080.
NABLIX_MAIN_BACKEND_URL=http://127.0.0.1:8001
NABLIX_STUDENT_MODEL_URL=https://nablix.ai:8080
NABLIX_STUDENT_MODEL_TOPIC_IDS={}
NABLIX_STUDENT_MODEL_TOPIC_CODES={"ALG_LINEAR_ONE_STEP":"ALG-ORI-02"}
# Shared with mathtutor-student's JWT_SECRET. Signs the internal_service bearer
# for /topic/event-history and /phase4-review, which reject a student's token.
# Without it Phase 4 reviews silently never generate.
NABLIX_STUDENT_MODEL_JWT_SECRET=
# Enable only after Student Model supports the read-only SESSION_OPENED event.
NABLIX_USE_MOCK_STUDENT_MODEL=false
VOICE_STT_PROVIDER=deepgram
VOICE_TTS_PROVIDER=openai
VOICE_TTS_VOICE=shimmer
VOICE_TTS_FORMAT=mp3
NABLIX_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NABLIX_OPENAI_API_KEY=
NABLIX_OPENAI_PROMPT_CACHE_KEY_ENABLED=true
NABLIX_OPENAI_STORE_RESPONSES=false
NABLIX_OCR_PROVIDER=openai
NABLIX_MATHPIX_APP_ID=
NABLIX_MATHPIX_APP_KEY=
NABLIX_USE_MOCK_TUTOR=true
NABLIX_USE_MOCK_VOICE=true
NABLIX_USE_MOCK_VISION=true

# Dev-only Student Model JSON debug view. Leave false in any environment a real
# student can reach: the captured responses contain the canonical answers.
NABLIX_DEBUG_JSON_VIEW=false
NABLIX_ADAPTER_REQUEST_TIMEOUT_SECONDS=20
NABLIX_ADAPTER_REQUEST_RETRY_COUNT=2
NABLIX_INACTIVITY_INITIAL_IDLE_THRESHOLD_MS=20000
NABLIX_INACTIVITY_COOLDOWN_MS=30000
NABLIX_INACTIVITY_MAX_NUDGES_PER_TUTOR_TURN=2
NABLIX_INACTIVITY_GENERATED_NUDGE_RATE_LIMIT=4
NABLIX_MAX_TEXT_INPUT_LENGTH=500
DEEPGRAM_API_KEY=
